{
  "name": "life-workbench-desktop",
  "version": "1.5.0",
  "private": true,
  "description": "本地优先的极简个人工作台",
  "author": "life-workbench",
  "main": "main.cjs",
  "build": {
    "appId": "com.lifeworkbench.app",
    "productName": "人生工作台",
    "electronVersion": "37.10.3",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "icon.png",
      "icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "人生工作台"
    }
  }
}
